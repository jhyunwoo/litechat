{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // @types/bun: 서버의 AppType(hc RPC)을 타입 검사할 때 bun:sqlite 등 서버 모듈 해석용
    "types": ["@types/bun", "jest"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
