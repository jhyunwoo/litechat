{
  "name": "litechat",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "brand:generate": "bun apps/app/scripts/generate-icons.ts",
    "brand:preview": "bun apps/app/scripts/preview-icons.ts",
    "store-assets:capture": "bun store-assets/scripts/capture-app-ui.ts",
    "store-assets:compose": "bun store-assets/scripts/compose-store-assets.ts",
    "store-assets:validate": "bun store-assets/scripts/validate-store-assets.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css,html}\""
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.2",
    "typescript": "5.9.2"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  }
}
