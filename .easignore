# EAS creates a shallow clone before overlaying the working tree. Explicitly
# exclude VCS history so deleted runtime data and credentials cannot enter the
# cloud-build context through Git objects.
.git

# Dependencies and package-manager artifacts
node_modules
.pnp
.pnp.js

# Local-only environment overrides
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Test and build output
coverage
.turbo
.vercel
.next/
out/
build
dist
e2e/test-results/

# Generated native projects (CNG regenerates these during EAS Build)
apps/app/ios/
apps/app/android/
apps/app/.expo/
apps/app/web-build/
apps/app/expo-env.d.ts
apps/app/*.tsbuildinfo

# Debug and editor files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.orig.*

# Credentials and signing material must be supplied by EAS, never uploaded.
*.pem
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Runtime state, user content and licensed GeoIP artifacts
**/data/*.db
**/data/*.db-shm
**/data/*.db-wal
**/data/uploads/
e2e/.data/
data/GeoLite2-*
apps/server/data/GeoLite2-*

# Store listing source files and generated screenshots are not native build inputs.
store-assets/
