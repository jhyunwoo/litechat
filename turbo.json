{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json", "bunfig.toml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      /*
       * 입력을 명시하지 않으면 turbo가 워크스페이스의 모든 파일(테스트/문서 포함)을
       * 해시에 넣어, 테스트만 고쳐도 프론트엔드가 통째로 다시 빌드된다.
       * 빌드에 실제로 영향을 주는 것만 남긴다.
       */
      "inputs": [
        "src/**",
        "public/**",
        "index.html",
        "build.ts",
        "vite.config.ts",
        "tsconfig.json",
        "package.json",
        ".env*",
        "!**/__tests__/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      /*
       * lite의 build.ts는 dist/assets 아래에 사전 압축(.br/.gz)까지 만들고,
       * web은 dist/sw.js·manifest도 만든다 — dist/** 하나로 모두 포함된다.
       */
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "jest.config.js", "jest-setup.ts", "package.json", "tsconfig.json"],
      "outputs": []
    },
    "lint": {
      "inputs": ["src/**", "eslint.config.js", "package.json"],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "*.ts", "tsconfig.json", "package.json"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
